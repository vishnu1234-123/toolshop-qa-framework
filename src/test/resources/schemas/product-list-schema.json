{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["current_page","data"],
  "properties": {
    "current_page": {"type": "integer","minimum": 1},
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id","name","price"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "price": {"type": "number"}
        }
      }
    }
  }
}