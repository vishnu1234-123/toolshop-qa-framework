	"item": [
		{
			"name": "Login - valid",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const json = pm.response.json();",
							"pm.environment.set(\"token\", json.access_token);",
							"console.log(\"token saved:\", pm.environment.get(\"token\") ? \"yes\" : \"no\");",
							"",
							"pm.test(\"Status is 200\",()=>pm.response.to.have.status(200));",
							"pm.test(\"Returns a bearer token\",()=> {",
							"    const json=pm.response.json();",
							"    pm.expect(json.access_token).to.be.a(\"string\").and.not.empty;",
							"    pm.expect(json.token_type).to.eql(\"bearer\");",
							"    });",
							"pm.test(\"Token expires in 300 seconds\",()=>{",
							"    pm.expect(pm.response.json().expires_in).to.eql(300);",
							"});",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\"email\": \"{{customerEmail}}\", \"password\": \"{{customerPassword}}\"}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/users/login",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"users",
						"login"
					]
				}
			},
			"response": []
		},
		{
			"name": "Get my profile",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const baseUrl=pm.environment.get(\"baseUrl\");",
							"const expiry=pm.environment.get(\"tokenExpiry\");",
							"",
							"if(!pm.environment.get(\"token\") || !expiry || Date.now()>Number(expiry)){",
							"    pm.sendRequest({",
							"        url:baseUrl+\"/users/login\",",
							"        method:\"POST\",",
							"        header:{\"Content-Type\":\"applications/json\"},",
							"        body:{",
							"            mode:\"raw\",",
							"            raw:JSON.stringify({",
							"                email:pm.environment.get(\"customerEmail\"),",
							"                password:pm.environment.get(\"customerPassword\")",
							"            })",
							"        }",
							"    },(err,res)=>{",
							"        if(!err && res.code==200){",
							"            const json=res.json();",
							"            pm.environment.set(\"token\",json.access_token);",
							"            pm.environment.set(\"tokenExpiry\", Date.now() + (json.expires_in - 30) * 1000);",
							"        }",
							"    }",
							"    )",
							"    ",
							"}"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
							"pm.test(\"Profile belongs to the logged-in customer\", () => {",
							"    pm.expect(pm.response.json().email).to.eql(pm.environment.get(\"customerEmail\"));",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{token}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/users/me",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"users",
						"me"
					]
				}
			},
			"response": []
		},
		{
			"name": "Products - list",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status is 200\",()=>pm.response.to.have.status(200));",
							"pm.test(\"Responds in under 1000 ms\",()=>pm.expect(pm.response.responseTime).to.be.below(1000));",
							"pm.test(\"Returns a non empty product list\",()=>{",
							"    const json=pm.response.json();",
							"    pm.expect(json.data).to.be.an(\"array\").that.is.not.empty;",
							"})",
							"",
							"pm.test(\"Each product has id,name and price\",()=>{",
							"    pm.response.json().data.forEach(p=>{",
							"        pm.expect(p).to.have.property(\"id\");",
							"        pm.expect(p).to.have.property(\"name\");",
							"        pm.expect(p.price).to.be.a(\"number\");",
							"    });",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/products",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"products"
					]
				}
			},
			"response": []
		},
